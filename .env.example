# Use the final public origin at build time, with no path or trailing slash.
SITE_URL=

# Enable search indexing once SITE_URL is set to the official public origin.
SITE_INDEXABLE=false

# Set a verified recipient for project inquiries.
CONTACT_EMAIL=

# Leave unset on Vercel. npm run build:static sets this for the static preview.
# SITE_STATIC_EXPORT=true
